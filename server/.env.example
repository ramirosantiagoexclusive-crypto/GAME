# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mmo_survival?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-use-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:5173"

# AFK Timers (seconds)
AFK_RAID_TIMEOUT=120
AFK_HUB_TIMEOUT=300

# Loot TTL (seconds)
LOOT_TTL=600

# Raid Duration (seconds)
RAID_DURATION=900
